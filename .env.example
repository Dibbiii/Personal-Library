# Copia in .env e adatta. Le variabili sono lette lato server ($env/dynamic/private).

# Connessione applicativa a PostgreSQL (ruolo con RLS)
DATABASE_URL=postgres://segnalibro_app:segnalibro_app@127.0.0.1:5433/segnalibro
# Ruolo amministrativo: solo per migration, reset e test di contratto
DATABASE_ADMIN_URL=postgres://postgres:postgres@127.0.0.1:5433/segnalibro

# Cartella dei file caricati (cover personalizzate)
STORAGE_DIR=./storage

# Nome del cookie di sessione httpOnly
SESSION_COOKIE_NAME=sb-session

# Provider metadata libri (solo server). Open Library non richiede chiave.
GOOGLE_BOOKS_API_KEY=

# Produzione (adapter-node): serve per l'upload delle cover personalizzate (max 5 MB)
# BODY_SIZE_LIMIT=6M
