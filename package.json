{
	"name": "segnalibro",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"lint:colors": "node scripts/check-no-hardcoded-colors.mjs",
		"format": "prettier --write .",
		"icons": "vite-node scripts/generate-icons.ts",
		"test": "vitest run",
		"db:up": "docker compose up -d db --wait",
		"db:migrate": "node scripts/db-migrate.mjs",
		"db:seed": "node scripts/db-seed.mjs",
		"db:reset": "node scripts/db-reset.mjs",
		"test:contracts": "vitest run tests/contracts/unit.contracts.test.ts tests/contracts/auth-unit.contracts.test.ts tests/contracts/storage.contracts.test.ts",
		"test:contracts:db": "RUN_DB_CONTRACT_TESTS=1 vitest run tests/contracts/db.contracts.test.ts",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.3",
		"@vite-pwa/sveltekit": "^1.1.0",
		"eslint": "^10.11.0",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"postgres": "^3.4.9",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"sharp": "^0.35.5",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"svelte-eslint-parser": "^1.8.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.0",
		"vite": "^8.3.1",
		"vite-node": "^6.0.0",
		"vite-plugin-pwa": "^1.3.0",
		"vitest": "^5.0.3"
	},
	"dependencies": {
		"@fontsource-variable/figtree": "^5.3.0",
		"@fontsource/young-serif": "^5.3.0",
		"@zxing/library": "^0.21.3",
		"idb": "^8.0.3",
		"zod": "^4.6.5"
	}
}
